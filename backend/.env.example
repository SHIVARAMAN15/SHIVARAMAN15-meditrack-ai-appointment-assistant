# MediTrack AI Backend Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-meditrack
DATABASE_URL=sqlite:///meditrack.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000

# Prediction Risk Thresholds (Configurable)
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.60

# Model artifact path relative to backend root
MODEL_ARTIFACT_PATH=app/ml/artifacts/attendance_model.joblib

# OpenRouter AI LLM Integration (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
